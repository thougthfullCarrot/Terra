{
  "name": "@terra/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Collector, match scoring, and feed API for the Terra Texas CRE job tracker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "collect": "tsx src/bin/collect.ts",
    "verify:firms": "tsx src/bin/verify-firms.ts",
    "probe:slugs": "tsx src/bin/probe-slugs.ts",
    "discover:ats": "tsx src/bin/discover-ats.ts",
    "export:site": "tsx src/bin/export-site.ts",
    "export:market": "tsx src/bin/export-market.ts",
    "export:news": "tsx src/bin/export-news.ts",
    "export:events": "tsx src/bin/export-events.ts",
    "export:appraisal": "tsx src/bin/export-appraisal.ts",
    "build:site": "tsx src/bin/build-site.ts",
    "sync:sheets": "tsx src/bin/sync-sheets.ts",
    "test-users": "tsx src/bin/test-users.ts",
    "send:alerts": "tsx src/bin/send-alerts.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "leaflet": "1.9.4",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.56.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
