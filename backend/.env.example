# Supabase project, from Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
# Service role key. The collector writes postings and matches for every
# profile, which RLS blocks for a user key. Server only — never ship this to
# the app.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scheduler sends as x-collector-secret on POST /v1/collect.
# Store the same value in Supabase Vault as 'collector_secret'.
COLLECTOR_SECRET=

# Optional. Only needed once the Expo project enforces push security.
EXPO_ACCESS_TOKEN=

# Local server port for `npx tsx src/bin/serve.ts`.
PORT=8787
